# 仅作为变量清单；复制为 .env 后填写本机值，不要提交真实密钥。
CAMPUS_DB_URL=jdbc:mysql://127.0.0.1:3307/campus_trade?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
CAMPUS_MYSQL_PORT=3307
CAMPUS_MYSQL_DATABASE=campus_trade
CAMPUS_DB_USER=campus_trade
CAMPUS_DB_PASSWORD=replace-me
CAMPUS_DB_ROOT_PASSWORD=replace-root-password
CAMPUS_JWT_SECRET=replace-with-base64-encoded-32-byte-secret
CAMPUS_REDIS_URL=redis://127.0.0.1:6379
CAMPUS_SMTP_HOST=127.0.0.1
CAMPUS_SMTP_PORT=1025
CAMPUS_SMTP_USER=
CAMPUS_SMTP_PASSWORD=
CAMPUS_SMTP_AUTH=false
CAMPUS_SMTP_STARTTLS=false
CAMPUS_SMTP_FROM=noreply@campustrade.local
CAMPUS_UPLOAD_DIR=./data/uploads
CAMPUS_AI_ENABLED=false
CAMPUS_AI_BASE_URL=https://api.openai.com/v1
CAMPUS_AI_API_KEY=
CAMPUS_AI_MODEL=gpt-4o-mini
CAMPUS_AI_CONNECT_TIMEOUT=3s
CAMPUS_AI_REQUEST_TIMEOUT=12s
CAMPUS_AI_RETRY_DELAY=200ms
CAMPUS_AI_RATE_LIMIT_PER_MINUTE=5
